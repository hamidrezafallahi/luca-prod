{
  "id": "seo-site-health-daily",
  "name": "SEO Site Health Daily",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 7 * * *"
            }
          ]
        }
      },
      "id": "cron",
      "name": "Daily 07:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 300]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "api",
              "name": "apiBase",
              "value": "={{ $env.API_BASE_URL || 'http://backend:8080/api' }}",
              "type": "string"
            },
            {
              "id": "hook",
              "name": "alertWebhook",
              "value": "={{ $env.SEO_ALERT_WEBHOOK_URL || '' }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "config",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [220, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.apiBase }}/Identity/login",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"emailOrPhone\": \"{{ $env.CONTENT_BOT_EMAIL }}\",\n  \"password\": \"{{ $env.CONTENT_BOT_PASSWORD }}\"\n}",
        "options": {}
      },
      "id": "login",
      "name": "Login Content Bot",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $('Config').item.json.apiBase }}/SeoOps/health",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $json.data.accessToken || $json.accessToken || $json.data?.accessToken }}"
            }
          ]
        },
        "options": {}
      },
      "id": "health",
      "name": "Probe SEO Health",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [660, 300]
    },
    {
      "parameters": {
        "jsCode": "const payload = $input.first().json;\nconst report = payload.data || payload;\nconst failed = (report.checks || []).filter((c) => !c.ok);\nconst lines = (report.checks || []).map((c) => `${c.ok ? '✅' : '❌'} ${c.name} ${c.statusCode ?? '-'} ${c.elapsedMs}ms ${c.error || ''}`);\nconst text = [\n  `SEO Health ${report.isHealthy ? 'OK' : 'FAILED'}`,\n  `Site: ${report.siteBaseUrl}`,\n  `Failed: ${report.failedCount}`,\n  '',\n  ...lines\n].join('\\n');\n\nreturn [{\n  json: {\n    isHealthy: !!report.isHealthy,\n    failedCount: report.failedCount || 0,\n    text,\n    alertWebhook: $('Config').item.json.alertWebhook,\n    report\n  }\n}];"
      },
      "id": "format",
      "name": "Format Report",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [880, 300]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ !$json.isHealthy && !!$json.alertWebhook }}",
              "value2": true
            }
          ]
        }
      },
      "id": "if-alert",
      "name": "Need Alert?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [1100, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.alertWebhook }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"text\": {{ JSON.stringify($json.text) }}\n}",
        "options": {}
      },
      "id": "webhook",
      "name": "Send Alert Webhook",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1320, 200],
      "continueOnFail": true
    }
  ],
  "connections": {
    "Daily 07:00": {
      "main": [[{ "node": "Config", "type": "main", "index": 0 }]]
    },
    "Config": {
      "main": [[{ "node": "Login Content Bot", "type": "main", "index": 0 }]]
    },
    "Login Content Bot": {
      "main": [[{ "node": "Probe SEO Health", "type": "main", "index": 0 }]]
    },
    "Probe SEO Health": {
      "main": [[{ "node": "Format Report", "type": "main", "index": 0 }]]
    },
    "Format Report": {
      "main": [[{ "node": "Need Alert?", "type": "main", "index": 0 }]]
    },
    "Need Alert?": {
      "main": [
        [{ "node": "Send Alert Webhook", "type": "main", "index": 0 }],
        []
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Tehran"
  },
  "versionId": "1",
  "meta": {
    "templateCredsSetupCompleted": true
  },
  "tags": [{ "name": "seo" }, { "name": "ops" }]
}
