{
  "id": "shop-product-create",
  "name": "Shop Product Create (Telegram owner)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "shop-product-create",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 300],
      "webhookId": "shop-product-create"
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first();\nconst secret = $env.SHOP_OWNER_WEBHOOK_SECRET;\nconst headers = item.json.headers || {};\nconst body = (item.json.body && typeof item.json.body === 'object') ? item.json.body : item.json;\n\nconst headerSecret = String(\n  headers['x-shop-webhook-secret'] ||\n  headers['X-Shop-Webhook-Secret'] ||\n  ''\n);\nconst bodySecret = String(body.webhookSecret || item.json.webhookSecret || '');\nconst authorized = !!secret && (headerSecret === secret || bodySecret === secret);\n\nconst name = String(body.name || '').trim();\nconst description = String(body.description || name).trim();\nconst categoryId = Number(body.categoryId);\nconst brandId = Number(body.brandId);\nconst price = Number(body.price ?? body.basePrice);\nconst inventory = Number(body.inventory);\nconst seoTitleFa = String(body.seoTitleFa || name).trim();\nconst metaDescriptionFa = String(body.metaDescriptionFa || description).slice(0, 160);\nconst slug = String(body.slug || '').trim();\nconst imageUrl = String(body.imageUrl || '').trim();\nconst width = Number(body.width);\nconst height = Number(body.height);\nconst depth = Number(body.depth);\nconst weight = Number(body.weight);\n\nlet error = '';\nlet httpStatus = 200;\nif (!authorized) {\n  error = 'Unauthorized webhook';\n  httpStatus = 401;\n} else if (!name || !Number.isFinite(categoryId) || categoryId <= 0 || !Number.isFinite(brandId) || brandId <= 0) {\n  error = 'name, categoryId and brandId are required';\n  httpStatus = 400;\n} else if (!Number.isFinite(price) || price <= 0 || !Number.isInteger(inventory) || inventory < 0) {\n  error = 'price must be > 0 and inventory must be a whole number >= 0';\n  httpStatus = 400;\n}\n\nreturn [{\n  json: {\n    ok: !error,\n    error,\n    httpStatus,\n    name,\n    description,\n    categoryId,\n    brandId,\n    price,\n    inventory,\n    seoTitleFa,\n    metaDescriptionFa,\n    slug: slug || undefined,\n    imageUrl: imageUrl || undefined,\n    width: Number.isFinite(width) ? width : 0,\n    height: Number.isFinite(height) ? height : 0,\n    depth: Number.isFinite(depth) ? depth : 0,\n    weight: Number.isFinite(weight) ? weight : 0,\n    apiBase: $env.API_BASE_URL || 'http://backend:8080/api',\n    siteBase: $env.CONTENT_ADMIN_BASE_URL || 'https://lucaloupe.com'\n  }\n}];"
      },
      "id": "parse",
      "name": "Parse Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 300]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.ok }}",
              "value2": true
            }
          ]
        }
      },
      "id": "ready",
      "name": "Ready?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [440, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: false, error: $json.error || 'Bad request' }) }}",
        "options": {
          "responseCode": "={{ $json.httpStatus || 400 }}"
        }
      },
      "id": "respond-error",
      "name": "Respond Error",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [660, 480]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.apiBase }}/Identity/login",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"emailOrPhone\": \"{{ $env.CONTENT_BOT_EMAIL }}\",\n  \"password\": \"{{ $env.CONTENT_BOT_PASSWORD }}\"\n}",
        "options": {}
      },
      "id": "login",
      "name": "Login Content Bot",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [660, 200]
    },
    {
      "parameters": {
        "jsCode": "const parsed = $('Parse Payload').item.json;\nconst login = $input.first().json;\nconst token = login.data?.accessToken || login.accessToken || login.data?.AccessToken;\nif (!token) {\n  return [{ json: { ok: false, httpStatus: 502, error: login.error || 'Login failed: no access token' } }];\n}\nreturn [{ json: { ...parsed, accessToken: token } }];"
      },
      "id": "keep-context",
      "name": "Keep Context",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [880, 200]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ !!$json.accessToken }}",
              "value2": true
            }
          ]
        }
      },
      "id": "logged-in",
      "name": "Logged In?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [1100, 200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.apiBase }}/CatalogItems",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $json.accessToken }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ name: $json.name, description: $json.description, categoryId: $json.categoryId, brandId: $json.brandId, seoTitleFa: $json.seoTitleFa, metaDescriptionFa: $json.metaDescriptionFa, slug: $json.slug || undefined, basePrice: $json.price, inventory: $json.inventory, width: $json.width, height: $json.height, depth: $json.depth, weight: $json.weight, imageUrl: $json.imageUrl || undefined, imageIsMain: true }) }}",
        "options": {}
      },
      "id": "create-catalog-item",
      "name": "Create Catalog Item",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1320, 120],
      "continueOnFail": true
    },
    {
      "parameters": {
        "jsCode": "const created = $input.first().json;\nconst ctx = $('Keep Context').item.json;\nconst n8nErr = created.error && typeof created.error === 'object'\n  ? (created.error.message || JSON.stringify(created.error))\n  : '';\n\nif (created.isSuccess === false) {\n  return [{ json: { ok: false, httpStatus: created.error === 'Unauthorized' ? 401 : 400, error: created.error || 'Create catalog item failed' } }];\n}\n\nconst data = created.data || {};\nconst productId = data.productId || data.ProductId;\nconst offerId = data.offerId || data.OfferId;\nconst imageId = data.imageId || data.ImageId || null;\nif (!productId || !offerId) {\n  return [{ json: { ok: false, httpStatus: 502, error: n8nErr || created.error || 'CatalogItems response missing ids' } }];\n}\n\nconst url = `${String(ctx.siteBase).replace(/\\/$/, '')}/fa/products/${productId}`;\nreturn [{ json: {\n  ok: true,\n  httpStatus: 200,\n  productId,\n  offerId,\n  imageId,\n  name: ctx.name,\n  price: ctx.price,\n  inventory: ctx.inventory,\n  url\n} }];"
      },
      "id": "attach-result",
      "name": "Attach Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1540, 120]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.ok }}",
              "value2": true
            }
          ]
        }
      },
      "id": "result-ok",
      "name": "Result Ok?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [1760, 120]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json) }}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "respond-success",
      "name": "Respond Success",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1980, 40]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [[{ "node": "Parse Payload", "type": "main", "index": 0 }]]
    },
    "Parse Payload": {
      "main": [[{ "node": "Ready?", "type": "main", "index": 0 }]]
    },
    "Ready?": {
      "main": [
        [{ "node": "Login Content Bot", "type": "main", "index": 0 }],
        [{ "node": "Respond Error", "type": "main", "index": 0 }]
      ]
    },
    "Login Content Bot": {
      "main": [[{ "node": "Keep Context", "type": "main", "index": 0 }]]
    },
    "Keep Context": {
      "main": [[{ "node": "Logged In?", "type": "main", "index": 0 }]]
    },
    "Logged In?": {
      "main": [
        [{ "node": "Create Catalog Item", "type": "main", "index": 0 }],
        [{ "node": "Respond Error", "type": "main", "index": 0 }]
      ]
    },
    "Create Catalog Item": {
      "main": [[{ "node": "Attach Result", "type": "main", "index": 0 }]]
    },
    "Attach Result": {
      "main": [[{ "node": "Result Ok?", "type": "main", "index": 0 }]]
    },
    "Result Ok?": {
      "main": [
        [{ "node": "Respond Success", "type": "main", "index": 0 }],
        [{ "node": "Respond Error", "type": "main", "index": 0 }]
      ]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Tehran"
  },
  "versionId": "p011-catalog-items",
  "meta": {
    "templateCredsSetupCompleted": true
  },
  "tags": [
    { "name": "owner" },
    { "name": "shop" },
    { "name": "telegram" }
  ]
}
